# Web UI & API Server Port (must be 3000 in AI Studio preview)
PORT=3000

# Avaya Aura CM Legacy CDR Adjunct Listener Configuration
CDR_LISTEN_HOST=0.0.0.0
CDR_LISTEN_PORT=5000
# Supported protocols: TCP | UDP | BOTH
CDR_PROTOCOL=TCP
# Supported format profiles: CM4PLUS | LEGACY | UNFORMATTED
CDR_FORMAT_PROFILE=CM4PLUS

# Directory for access.log, error.log, cdr-listener.log, and cdr-raw.log
LOG_DIR=./logs

# Optional GitHub repository configuration for in-app update checking/applying
GITHUB_REPO=
GITHUB_BRANCH=main
# GITHUB_TOKEN= (optional, only if your GitHub repo is private)

# Authentication for self-hosted Linux/Docker servers
# Generate a strong secret: openssl rand -hex 32
AUTH_SECRET=
# Optional preset local admin credentials (if omitted, create via Web UI on first visit)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional custom Firebase project overrides (for Google Sign-In on your own domain)
# Add your server domain under Firebase Console -> Authentication -> Settings -> Authorized domains
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# PostgreSQL (Cloud SQL runtime variables injected automatically in managed runtime)
SQL_HOST=/cloudsql/PROJECT:REGION:INSTANCE
SQL_DB_NAME=postgres
SQL_USER=app_user
SQL_PASSWORD=CHANGE_ME
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=CHANGE_ME

# AI Studio platform runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
